import de.visualdigits.common.domain.util.EncryptedString;
import kotlin.Boolean;

--
-- SETTINGS
--
CREATE TABLE SettingsEntity (
    id INTEGER NOT NULL DEFAULT 0,
    language TEXT NOT NULL,
    lastMaxImageSize INTEGER NOT NULL,
    aisstreamApiKey TEXT AS EncryptedString NOT NULL DEFAULT "",
    location TEXT NOT NULL,
    useGpsLocation INTEGER AS Boolean NOT NULL,
    warningDistance TEXT NOT NULL,
    radiusOuter TEXT NOT NULL,
    radiusInner TEXT NOT NULL
);

insertSettings:
INSERT INTO SettingsEntity (
    language, lastMaxImageSize, aisstreamApiKey, location, useGpsLocation, warningDistance, radiusOuter, radiusInner
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getSettingsById:
SELECT * FROM SettingsEntity WHERE id = :id;

updateSettingsEntity:
UPDATE SettingsEntity
SET language = :language,
    lastMaxImageSize = :lastMaxImageSize,
    aisstreamApiKey = :aisstreamApiKey,
    location = :location,
    warningDistance = :warningDistance,
    useGpsLocation = :useGpsLocation,
    radiusOuter = :radiusOuter,
    radiusInner = :radiusInner
WHERE id IS :id;

deleteSettings:
DELETE FROM SettingsEntity
WHERE id IS :id;

--
-- MasterData
--
CREATE TABLE MasterDataEntity (
    messageType TEXT NOT NULL,
    name TEXT NOT NULL,
    mmsi INTEGER NOT NULL PRIMARY KEY,
    timeUtc TEXT NOT NULL,
    imoNumber INTEGER NOT NULL DEFAULT 0,
    callSign TEXT NOT NULL DEFAULT "",
    destination TEXT NOT NULL DEFAULT "",
    totalLength INTEGER NOT NULL DEFAULT 0,
    totalWidth INTEGER NOT NULL DEFAULT 0,
    shipType INTEGER NOT NULL DEFAULT 0,
    maximumStaticDraught REAL NOT NULL
);

upsertMasterData:
INSERT OR REPLACE INTO MasterDataEntity(
    messageType, name, mmsi, timeUtc, imoNumber, callSign, destination, totalLength, totalWidth, shipType, maximumStaticDraught
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllMasterData:
SELECT * FROM MasterDataEntity;

getMasterDataByMmsi:
SELECT * FROM MasterDataEntity WHERE mmsi = :mmsi;

deleteMasterData:
DELETE FROM MasterDataEntity
WHERE mmsi IS :mmsi;

--
-- Starred List
--
CREATE TABLE StarredVesselEntity(
    messageType TEXT NOT NULL,
    name TEXT NOT NULL,
    mmsi INTEGER NOT NULL PRIMARY KEY,
    mmsiDeviceType TEXT NOT NULL,
    mmsiCountry TEXT NOT NULL,
    timeUtc TEXT NOT NULL,
    timeUtcObserved TEXT,
    vesselLatitude REAL NOT NULL,
    vesselLongitude REAL NOT NULL,
    observingLatitude REAL,
    observingLongitude REAL,
    sog REAL NOT NULL,
    speedKmh REAL NOT NULL,
    heading REAL NOT NULL,
    rateOfTurnDegreesPerMinute REAL NOT NULL,
    navigationalStatus INTEGER NOT NULL,
    imoNumber INTEGER,
    callSign TEXT,
    destination TEXT,
    totalLength INTEGER,
    totalWidth INTEGER,
    shipType INTEGER NOT NULL,
    maximumStaticDraught REAL,
    distance REAL NOT NULL,
    hasSafetyMessage INTEGER AS Boolean NOT NULL,
    messageId INTEGER,
    repeatIndicator INTEGER,
    valid INTEGER AS Boolean DEFAULT 0,
    text TEXT
);

upsertStarredVesselEntity:
INSERT OR REPLACE INTO StarredVesselEntity(
    messageType, name, mmsi, mmsiDeviceType, mmsiCountry, timeUtc, timeUtcObserved, vesselLatitude, vesselLongitude, observingLatitude, observingLongitude, sog, speedKmh, heading, rateOfTurnDegreesPerMinute, navigationalStatus, imoNumber, callSign, destination, totalLength, totalWidth, shipType, maximumStaticDraught, distance, hasSafetyMessage, messageId, repeatIndicator, valid, text
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllStarredVesselEntities:
SELECT * FROM StarredVesselEntity;

getStarredVesselEntityByMmsi:
SELECT * FROM StarredVesselEntity WHERE mmsi = :mmsi;

deleteStarredVesselEntity:
DELETE FROM StarredVesselEntity
WHERE mmsi IS :mmsi;

deleteAllStarredVesselEntities:
DELETE FROM StarredVesselEntity;
